# Copiar a backend/.env y rellenar:
DEBUG=1
SECRET_KEY=dev-insecure-change-me
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Conexion al Oracle del sistema legado (corre en el host Windows)
ORACLE_DSN=host.docker.internal:1521/AB
ORACLE_USER=JCABREU
ORACLE_PASSWORD=
